# .gitignore
# WordBook 项目 Git 忽略配置

# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.pyo

# 虚拟环境
.venv/
venv/
env/
ENV/
.python-version

# 构建与打包产物
build/
dist/
installer/
*.exe
*.msi
*.zip
*.dll
*.pyd

# 运行数据、用户数据、日志、数据库
data/backup/
data/logs/
data/user/
data/wordbook.db
*.log
*.db
*.sqlite
*.sqlite3

# 环境变量与密钥
.env
.env.*
*.pem
*.key
git.txt

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 生成的目录树
tree.txt

# 测试、类型检查、lint 缓存
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
tools/

# Python 打包元数据
*.egg-info/
.eggs/
